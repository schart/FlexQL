{
  "name": "@xeja/flexql",
  "version": "1.0.0",
  "description": "A lightweight but powerful query language engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "image.png"
  ],
  "type": "commonjs",
  "author": "",
  "license": "ISC",
  "scripts": {
    "build": "tsc && tsc-alias",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "start": "ts-node -r tsconfig-paths/register src/demo/demo.ts",
    "start:dev": "ts-node -r tsconfig-paths/register src/demo/demo.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand"
  },
  "keywords": [],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.15",
    "@types/pg": "^8.18.0",
    "eslint": "^9.31.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.31",
    "@ai-sdk/openai": "^3.0.47",
    "@nestjs/config": "^4.0.3",
    "ai": "^6.0.134",
    "dotenv": "^17.3.1",
    "lodash": "^4.17.21",
    "mongoose": "^9.1.2",
    "pg": "^8.20.0",
    "sequelize": "^6.37.7"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
